<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^(?:includes|views|vendor|config|sessions|logs|cache|tmp|temp|backup)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^(?:config\.php|config/|includes/config/|\.env(?:\..*)?|credentials\.json|token\.json|token_[^/]+\.txt|account_[^/]+\.txt|[^/]*\.(?:log|sql|sql\.gz|bak|bak2|save|phpt|pub)|manage\.php|check_speed\.php|test\.php|dashboard\.php|listening\.php|modules/(?:test|hikvision_sync|settings_ajax)\.php)$ - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ router.php [QSA,L]
</IfModule>

Options -Indexes

# Kengaytmasiz fayllar (SSH kalitlar, zaxira va skriptlar) hech qachon berilmasin
<IfModule mod_authz_core.c>
    <FilesMatch "^[^.]+$">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(?:pub|phpt|env|ini|lock|md)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:\.|credentials\.json|token\.json|token_[^/]+\.txt|account_[^/]+\.txt|[^/]*\.(?:log|sql|bak|bak2|save|phpt|pub))$">
        Require all denied
    </FilesMatch>
</IfModule>
